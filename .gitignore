__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# model/*.onnx and *.rknn are committed directly rather than gitignored or
# moved to LFS -- they change rarely and a clone must be able to deploy
# without a second download step.

# Confidential documents
*.docx

# Internal transition/handover notes — not for the public repo
transition.md

# Cached aarch64 cross-compile toolchain (local build cache, not source --
# see the "Build" section of the top-level README.md)
/aarch64-ubuntu20.04-toolchain.tar.gz

# Compiled binaries in board_deploy/ -- build outputs, not source. Rebuild
# via CMake (see README's "Build" section) and pscp the result to a board;
# don't commit rebuilds here, they bloat git history with binary blobs.
/board_deploy/benchmark
/board_deploy/ocr_server
/board_deploy/step_matcher

# Top-level CMake build directory -- fully regenerable, see the "Build"
# section of the top-level README.md.
/build/

# Cross-compile build directory, same reasoning as /build/ above.
/build-arm/

# Sweep script output -- raw data from a single test run, not source.
# Results that matter get written into documentation/Automation_Pipeline.docx;
# this file is regenerated by board_deploy/sweep_det_thresholds.sh.
sweep_results.csv

# Visual Studio local IDE state / CMake integration -- machine-local,
# fully regenerable, not part of the documented command-line build.
.vs/
out/
CMakeSettings.json
CppProperties.json
